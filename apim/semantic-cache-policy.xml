<policies>
    <inbound>
        <base />
        <set-backend-service backend-id="openai-backend" />
        <llm-semantic-cache-lookup score-threshold="0.05" embeddings-backend-id="embeddings-backend" embeddings-backend-auth="system-assigned" ignore-system-messages="true" max-message-count="10">
            <vary-by>shared</vary-by>
        </llm-semantic-cache-lookup>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <llm-semantic-cache-store duration="300" />
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>